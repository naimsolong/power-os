# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/poweros
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=poweros

# Object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=poweros
MINIO_ENDPOINT=http://minio:9000

# Application
APP_HOST=0.0.0.0
APP_PORT=3000
RUST_LOG=info
# Set to false for local HTTP development; true (default) in production.
COOKIE_SECURE=false
